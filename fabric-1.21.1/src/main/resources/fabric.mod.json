{
  "schemaVersion": 1,
  "id": "pvpocket",
  "version": "${version}",
  "name": "PvPocket",
  "description": "Isolated duel sessions for SMP servers: custom loadouts, best-of-N rounds, per-round Legacy 1.8 combat, and a full restore of survival state afterwards.",
  "authors": [
    "leipishu"
  ],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/pvpocket/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.leipishu.pvpocket.platform.fabric.FabricEntrypoint"
    ],
    "client": [
      "com.leipishu.pvpocket.client.PvPocketClient"
    ]
  },
  "mixins": [
    "pvpocket.mixins.json",
    {
      "config": "pvpocket.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
